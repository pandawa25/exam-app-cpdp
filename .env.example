# PostgreSQL connection (Railway addon mengisi ini otomatis saat deploy)
DATABASE_URL="postgresql://user:password@localhost:5432/exam_app?schema=public"

# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Berapa kali pelanggaran (tab-switch/fullscreen-exit) sebelum auto-submit
VIOLATION_THRESHOLD=3
